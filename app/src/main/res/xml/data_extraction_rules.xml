<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: back up medicines, dose history and photos to the user's own Google account, but not the "medtrack"
    preferences (setupDone and friends): permissions aren't restored on a new phone, so it must run Get set again.
    The cache and noBackupFilesDir (the brand list) are never backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="medtrack.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="medtrack.xml" />
    </device-transfer>
</data-extraction-rules>
